# === LLM ===
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.6-flash
JWT_SECRET=replace_with_a_long_random_secret
GOOGLE_CLIENT_ID=

# === Database ===
# SQLite by default (zero setup). To use Postgres instead, set e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/drmood
DATABASE_URL=sqlite:///./drmood.db

# === Vector store (ChromaDB, local persistent) ===
CHROMA_PERSIST_DIR=./chroma_store
CHROMA_COLLECTION=clinical_sources

# === Embeddings model (runs locally via sentence-transformers, no API key needed) ===
EMBEDDING_MODEL=all-MiniLM-L6-v2

# === Retrieval ===
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.35

# === App ===
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501
